LLM_PROVIDER=gemini            # gemini | groq | xai | ollama | anthropic
LLM_TEMPERATURE=0

GOOGLE_API_KEY=
GEMINI_MODEL=                  # انسخ الاسم من Google AI Studio

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# بحث على النت للـ outline (اختياري)
TAVILY_API_KEY=

MAX_REVISIONS=3

# تتبّع الـ agents (اختياري، بيشتغل تلقائياً مع LangGraph)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-presentation
